<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Version Management for Releases -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    
    <!-- Metadata for Release Artifacts -->
    <Product>Post Application API</Product>
    <Company>Post Application</Company>
    <Description>Modern ASP.NET Core 8 API with Clean Architecture and CQRS pattern</Description>
    <PackageProjectUrl>https://github.com/mohammedhossam3300-ctrl/post-application-Api</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mohammedhossam3300-ctrl/post-application-Api</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- Deterministic Build Settings -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoMapper 13 is compatible with .NET 9 Microsoft.Extensions packages -->
    <PackageReference Include="AutoMapper" Version="13.0.0" />
    <!-- MediatR 12 — AddMediatR + IPipelineBehavior registrations in ApplicationServicesExtension -->
    <!-- Extensions package removed: merged into MediatR 12 base package -->
    <PackageReference Include="MediatR" Version="12.0.0" />
    <!-- FluentValidation — AddValidatorsFromAssembly in ApplicationServicesExtension -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
    <!-- Swagger UI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- EF Core tooling (dotnet ef migrations) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.17">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Post.Application\Post.Application.csproj" />
    <ProjectReference Include="..\Post.Infrastructure\Post.Infrastructure.csproj" />
  </ItemGroup>

</Project>
