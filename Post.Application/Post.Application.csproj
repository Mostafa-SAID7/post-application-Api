<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Version Management for Releases -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    
    <!-- Metadata for Release Artifacts -->
    <Product>Post Application Logic</Product>
    <Company>Post Application</Company>
    <Description>Application layer with business logic, commands, and queries</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    
    <!-- Deterministic Build Settings -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Features\Posts\Commands\DeletePost\" />
  </ItemGroup>

  <ItemGroup>
    <!-- AutoMapper — entity-to-DTO mapping profiles -->
    <PackageReference Include="AutoMapper" Version="13.0.0" />
    <!-- FluentValidation — command validators -->
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <!-- MediatR 12 — IRequest, IRequestHandler, IPipelineBehavior -->
    <!-- Extensions package removed: merged into MediatR 12 base package -->
    <PackageReference Include="MediatR" Version="12.0.0" />
    <!-- Logging abstractions for behaviors — must match Caching.Memory transitive requirement -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
    <!-- In-memory cache for CachingBehavior — updated from 8.0.0 (known vuln) -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Post.Domain\Post.Domain.csproj" />
  </ItemGroup>

</Project>
