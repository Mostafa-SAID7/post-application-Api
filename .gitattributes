# Normalize line endings across platforms
* text=auto

# C# files
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf

# JSON
*.json text eol=lf
*.jsonc text eol=lf

# Markdown
*.md text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Binaries
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.db binary

# Visual Studio
*.vs binary
